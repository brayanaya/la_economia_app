# Copiar este archivo a ".env" y ajustar los valores antes de levantar el proyecto.
# En PowerShell:  Copy-Item .env.example .env
# En Linux/macOS: cp .env.example .env

# ---- Base de datos ------------------------------------------------------
POSTGRES_DB=la_economia_db
POSTGRES_USER=la_economia_user
POSTGRES_PASSWORD=cambia_esta_clave_en_produccion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- AplicaciÃ³n -----------------------------------------------------------
APP_NAME=La Economia Aya API
APP_VERSION=0.1.0
DEBUG=true

# URL publica del frontend; el backend la usa para armar el redirect-url
# al que Wompi devuelve al cliente despues de pagar.
APP_PUBLIC_URL=http://localhost:3000

# ---- IA: embeddings (Ollama por defecto) ------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768
# Con docker compose, Ollama vive en el servicio "ollama"; en local nativo
# usa http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
UMBRAL_SIMILITUD_MINIMA=0.60

# Alternativa de embeddings con OpenAI (solo si EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- IA: respuestas del agente conversacional --------------------------------
# LLM_PROVIDER: "auto" (Claude si hay API key; si no Ollama), "anthropic" o
# "ollama". Si ninguno responde, el agente contesta con un respondedor
# determinista basado en los productos recuperados: el chat nunca se cae.
LLM_PROVIDER=auto
# Modelo de Ollama para chat en local (gratuito)
LLM_MODEL=qwen2.5:7b
# Modelo de Claude para maxima calidad (requiere ANTHROPIC_API_KEY con saldo;
# alternatives economicas: claude-sonnet-5-5, claude-haiku-5-5)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=16000

# ---- Pagos en linea: Wompi (Colombia) ----------------------------------------
# Deja las claves vacias para desactivar la pasarela (el checkout solo ofrece
# contra entrega / Bre-B). Para pruebas usa las llaves pub_test/integrity de
# tu cuenta sandbox en https://wompi.co (Panel > Credenciales) y WOMPI_AMBIENTE=sandbox.
# WOMPI_EVENTS_SECRET se configura en el Panel de Wompi (Eventos) y firma el webhook.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_AMBIENTE=sandbox

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.56.1:3000","http://localhost:8081"]

# ---- Cuentas de clientes -----------------------------------------------
AUTH_COOKIE_NAME=la_economia_session
# En produccion (HTTPS) va true; en local http usa false para que el navegador
# acepte la cookie de sesion.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=1209600

# Copiar este archivo a ".env" y ajustar los valores antes de levantar el proyecto.
# En PowerShell:  Copy-Item .env.example .env

# ---- Base de datos ------------------------------------------------------
POSTGRES_DB=la_economia_db
POSTGRES_USER=la_economia_user
POSTGRES_PASSWORD=cambia_esta_clave_en_produccion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- AplicaciÃ³n -----------------------------------------------------------
APP_NAME=La Economia Aya API
APP_VERSION=0.1.0
DEBUG=true

# ---- Proveedor de embeddings (RAG) ----------------------------------------
# Valores permitidos: "sentence_transformers" (local, gratis) | "openai"
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_DIMENSIONS=768
SENTENCE_TRANSFORMERS_MODEL=paraphrase-multilingual-mpnet-base-v2

# Solo requerido si EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
UMBRAL_SIMILITUD_MINIMA=0.5

# Copiar este archivo a ".env" y ajustar los valores antes de levantar el proyecto.
# En PowerShell:  Copy-Item .env.example .env

# ---- Base de datos ------------------------------------------------------
POSTGRES_DB=la_economia_db
POSTGRES_USER=la_economia_user
POSTGRES_PASSWORD=cambia_esta_clave_en_produccion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- AplicaciÃ³n -----------------------------------------------------------
APP_NAME=La Economia Aya API
APP_VERSION=0.1.0
DEBUG=true

# ---- IA: embeddings y chat local mediante Ollama ---------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:7b
UMBRAL_SIMILITUD_MINIMA=0.60

# Alternativa de embeddings con OpenAI (solo si EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.56.1:3000","http://localhost:8081"]

# ---- Cuentas de clientes -----------------------------------------------
AUTH_COOKIE_NAME=la_economia_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=1209600
